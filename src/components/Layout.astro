---
import { ClientRouter } from 'astro:transitions';
import { DEFAULT_PALETTE } from '../lib/palette';
import { SITE_NAME, SITE_URL } from '../lib/site';
import Footer from './Footer.astro';
import Header from './header/index.astro';
import SearchOverlay from './SearchOverlay.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  image = '/assets/og.png',
  publishedTime,
  modifiedTime,
  author = '机场homes 评测实验室',
} = Astro.props;

const site = SITE_URL;
// If canonicalPath is not explicitly passed, automatically use current Astro.url.pathname!
const path = canonicalPath !== undefined ? canonicalPath : Astro.url.pathname;
const canonicalUrl = new URL(path, site).toString();
const ogImageUrl = new URL(image, site).toString();

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description,
  inLanguage: 'zh-CN',
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#f0eee9" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Search Engine Ownership Verification Placeholders (Direct in static HTML) */}
    {/* Google Search Console */}
    <meta name="google-site-verification" content="GOOGLE_VERIFICATION_CODE_PLACEHOLDER" />
    {/* Bing Webmaster Tools */}
    <meta name="msvalidate.01" content="BING_VERIFICATION_CODE_PLACEHOLDER" />
    {/* 神马站长平台 (Shenma / UC / Quark) */}
    <meta name="shenma-site-verification" content="SHENMA_VERIFICATION_CODE_PLACEHOLDER" />
    {/* 百度搜索资源平台 (Baidu) */}
    <meta name="baidu-site-verification" content="BAIDU_VERIFICATION_CODE_PLACEHOLDER" />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={websiteSchema} />

    <link rel="preload" href="/assets/jbm.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ DEFAULT_PALETTE }}>
      (() => {
        const apply = () => {
          const saved = localStorage.getItem('site-palette');
          const system = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? DEFAULT_PALETTE.dark
            : DEFAULT_PALETTE.light;
          document.documentElement.setAttribute('data-palette', saved || system);
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <link rel="stylesheet" href="/css/style.css" />
    <ClientRouter />
  </head>
  <body>
    <Header />

    <slot />

    <Footer />

    <ThemeSwitcher />

    <SearchOverlay />
  </body>
</html>

---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { formatPostDate, postSlug } from '../../lib/posts';
import { AUTHOR_NAME, SITE_NAME, SITE_URL } from '../../lib/site';
import { slugifyTag } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => {
      const slug = postSlug(post);
      return {
        params: { slug },
        props: { post, slug },
      };
    });
}

const { post, slug } = Astro.props;
const { Content, headings } = await render(post);
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
// Tags whose slug is empty have no archive page; skip their chips.
const tags = post.data.tags.filter((tag) => slugifyTag(tag) !== '');

const postSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${slug}/`, SITE_URL).toString(),
  },
  url: new URL(`/blog/${slug}/`, SITE_URL).toString(),
  author: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: new URL('/about/', SITE_URL).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
  },
}).replace(/</g, '\\u003c');
---

<Layout
  title={`${post.data.title} — ${SITE_NAME}`}
  description={post.data.description}
  canonicalPath={`/blog/${slug}/`}
  ogType="article"
>
  <script type="application/ld+json" is:inline set:html={postSchema} />
  <main class="content-shell">
    <div class="article-layout section" style="max-width: var(--max); padding-inline: 1.25rem;">
      <aside class="article-toc" aria-label="Article sections">
        {sectionHeadings.length > 0 && (
          <nav>
            {sectionHeadings.map((heading) => (
              <a href={`#${heading.slug}`} data-heading-link={heading.slug}>{heading.text}</a>
            ))}
          </nav>
        )}
      </aside>

      <article class="article-shell" data-pagefind-body>
        <header class="article-header">
          <p class="post-meta">
            <time datetime={post.data.date.toISOString()}>
              {formatPostDate(post.data.date)}
            </time>
            {/* data-pagefind-ignore keeps tag labels out of the search index. */}
            {tags.map((tag) => (
              <a href={`/tags/${slugifyTag(tag)}/`} data-pagefind-ignore>#{tag}</a>
            ))}
          </p>
          <h1>{post.data.title}</h1>
          <p>{post.data.description}</p>
        </header>
        <div class="article-prose">
          <Content />
        </div>
      </article>
    </div>
  </main>

  <script>
    let tocObserver: IntersectionObserver | undefined;

    function initToc() {
      tocObserver?.disconnect();
      const headings = Array.from(document.querySelectorAll('.article-prose h2[id]'));
      const links = new Map(
        Array.from(document.querySelectorAll('[data-heading-link]')).map((link) => [
          link.getAttribute('data-heading-link'),
          link,
        ]),
      );
      if (headings.length === 0 || links.size === 0) return;

      function setActive(id: string) {
        for (const link of links.values()) link.removeAttribute('aria-current');
        links.get(id)?.setAttribute('aria-current', 'true');
      }

      setActive(headings[0].id);
      tocObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible?.target instanceof HTMLElement) setActive(visible.target.id);
        },
        { rootMargin: '-18% 0px -68% 0px', threshold: 0 },
      );
      for (const heading of headings) tocObserver.observe(heading);
    }

    function init() {
      initToc();
    }

    init();
    // Module scripts run once per session; re-init after view-transition
    // navigations (e.g. post → post through the archive tree).
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style is:global>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
    margin: 0 0 0.85rem;
    color: color-mix(in srgb, var(--ink) 58%, var(--muted));
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .post-meta > * + *::before {
    content: "/";
    margin-right: 0.55rem;
    color: var(--line-strong);
  }

  .article-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) minmax(0, 860px);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
    padding-top: 4rem;
    border-top: 0;
  }

  .article-toc {
    position: sticky;
    top: 6rem;
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .article-toc nav {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-left: 0.85rem;
    border-left: 1px solid var(--line);
  }

  .article-toc a {
    color: var(--muted);
    text-decoration: none;
    line-height: 1.45;
    transition: color 120ms ease;
  }

  .article-toc a:hover,
  .article-toc a[aria-current="true"] {
    color: var(--accent);
  }

  .article-shell {
    min-width: 0;
  }

  .article-header {
    margin-bottom: 2.75rem;
  }

  .article-header h1 {
    margin: 0 0 0.6rem;
    font-family: var(--mono);
    font-size: clamp(1.85rem, 4.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .article-header p:last-child {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .article-prose {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  .article-prose p {
    margin: 0 0 1.5rem;
  }

  .article-prose h2 {
    margin: 3rem 0 1rem;
    font-family: var(--mono);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    scroll-margin-top: 6rem;
  }

  .article-prose h3 {
    margin: 2.25rem 0 0.85rem;
    font-family: var(--mono);
    font-size: 1.18rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    scroll-margin-top: 6rem;
  }

  .article-prose ul,
  .article-prose ol {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .article-prose li {
    margin-bottom: 0.45rem;
  }

  .article-prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-prose a:hover {
    color: var(--ink);
  }

  .article-prose blockquote {
    margin: 2rem 0;
    padding: 0.85rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink);
    font-style: italic;
  }

  .article-prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .article-prose pre {
    margin: 1.75rem 0;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-strong);
    overflow-x: auto;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .article-prose code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--code-bg, color-mix(in srgb, var(--line) 40%, transparent));
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
  }

  .article-prose pre code {
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0;
  }

  @media (max-width: 1040px) {
    .article-layout {
      display: block;
      max-width: 860px;
    }

    .article-toc {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .article-layout {
      padding-top: 2.25rem;
    }
  }
</style>

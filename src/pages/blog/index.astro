---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import TypedLede from '../../components/TypedLede.astro';
import SkillsMarquee from '../../components/SkillsMarquee.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_NAME } from '../../lib/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title={`Blog — ${SITE_NAME}`}
  description={`${SITE_NAME} 文章归档列表，涵盖前端工程、全栈架构与开发实践。`}
  canonicalPath="/blog/"
>
  <main class="content-shell">
    <section class="page-hero">
      <h1 class="visually-hidden">Blog - {SITE_NAME}</h1>
      <TypedLede text="文章归档：记录技术细节与系统思考。" />
    </section>

    <section class="section" aria-label="Blog posts">
      {posts.length === 0 ? (
        <p style="color: var(--muted); font-family: var(--mono);">暂无文章，敬请期待更新。</p>
      ) : (
        <div class="post-list">
          {posts.map((post, index) => <PostCard post={post} latest={index === 0} />)}
        </div>
      )}
    </section>

    <SkillsMarquee />
  </main>
</Layout>

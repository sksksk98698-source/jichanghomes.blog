---
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { AIRPORTS, FEATURED_AIRPORT, TOP10_AIRPORTS } from '../data/airports';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_NAME, SITE_TITLE, SITE_URL } from '../lib/site';

// 首页多维结构化数据 (JSON-LD)
const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
    logo: `${SITE_URL}/favicon.svg`,
  },
}).replace(/</g, '\\u003c');

const top10ItemListSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '2026 精选 TOP 10 跨境网络专线机场综合排行榜',
  description: '由机场homes评测实验室基于真实自费套餐、全国多地固定探针与晚高峰打流压测评选出的 TOP 10 机场名单。',
  itemListElement: TOP10_AIRPORTS.map((item, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Product',
      name: `${item.name} 机场加速服务`,
      url: `${SITE_URL}/airports/${item.id}/`,
      description: item.description,
      brand: {
        '@type': 'Brand',
        name: item.name,
      },
      offers: {
        '@type': 'Offer',
        price: item.pricingTiers?.[0]?.price?.replace('¥', '') || '10',
        priceCurrency: 'CNY',
        url: item.affUrl,
      },
    },
  })),
}).replace(/</g, '\\u003c');

const homeFaqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '2026 年挑选机场，最重要的三个核心指标是什么？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '第一是“运营年资”（优先选择连续稳定运营 3 年以上的老牌服务商，如 2020 年运营至今的光速云）；第二是“物理线路真实性”（认准企业级 IEPL/IPLC 跨境物理专线，杜绝晚高峰拥堵丢包的公网直连）；第三是“是否支持灵活月付”（新手初次尝试切忌直接买 3 年超长年付，坚持先月付实测）。',
      },
    },
    {
      '@type': 'Question',
      name: '为什么有的机场号称 1000M 但晚上看视频依然卡顿？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '普通廉价机场使用的是公网中转或公网直连，在晚高峰 20:00~23:00 全国用网高峰期，国际互联交换中心会产生严重的排队拥塞，丢包率往往超过 30%。而真正的 IEPL/IPLC 内网专线在物理层面完全不走公网 GFW 审查路由，因此能保持 0 丢包和超低延迟。',
      },
    },
    {
      '@type': 'Question',
      name: '机场homes 评测实验室的测速数据是否真实可靠？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '实验室所有评测账号均为自费匿名采购的普通零售套餐，拒绝商家特供测试号；17+ 份测速截图全部保持 1122×1402 px 原始分辨率与测试时间戳，经 SHA-256 哈希校验归档于测速实验室中，防伪可溯源。',
      },
    },
  ],
}).replace(/</g, '\\u003c');
---

<Layout
  title={`${SITE_NAME} — 2026 专业网络可观测性实验室：42家机场专线实测、原始证据链与客户端导航`}
  description="机场homes (jichanghomes.blog) 独立技术观察站：收录42家主流机场客观评测数据、17份原始高清测速图、TOP 10专线排行榜、全平台客户端(Clash/小火箭/软路由)配置教程与跑路风险审计指南。"
  canonicalPath="/"
>
  <script type="application/ld+json" is:inline set:html={websiteSchema} />
  <script type="application/ld+json" is:inline set:html={top10ItemListSchema} />
  <script type="application/ld+json" is:inline set:html={homeFaqSchema} />

  <main class="content-shell" data-pagefind-body>
    <!-- 顶部状态栏 -->
    <div class="noc-status-bar font-mono">
      <div class="noc-status-indicator">
        <span class="noc-status-dot"></span>
        <span>DARK NETWORK OBSERVATORY · 42 BRANDS ACTIVE · 17 LAB BENCHMARKS VERIFIED</span>
      </div>
      <span class="noc-date">2026 AUDIT COMPLETED</span>
    </div>

    <!-- 首页英雄区 -->
    <div class="page-hero">
      <h1 class="visually-hidden">{SITE_NAME}</h1>
      <TypedLede text="2026 专业网络可观测性实验室：42 家机场专线实测、原始测速证据链与全平台客户端导航。" />
    </div>

    <!-- 核心承诺指标条 -->
    <div class="trust-metrics-bar font-mono">
      <div class="trust-metric-item">
        <span class="metric-icon">🛡️</span>
        <div class="metric-text">
          <strong>42 家全网监测</strong>
          <span>全景价格/线路/协议全维审计</span>
        </div>
      </div>
      <div class="trust-metric-item">
        <span class="metric-icon">📸</span>
        <div class="metric-text">
          <strong>17 份原始证据</strong>
          <span>1122×1402 高清防伪快照</span>
        </div>
      </div>
      <div class="trust-metric-item">
        <span class="metric-icon">⚡</span>
        <div class="metric-text">
          <strong>180 分钟晚高峰打流</strong>
          <span>穿透假专线，拒绝纸面虚高</span>
        </div>
      </div>
      <div class="trust-metric-item">
        <span class="metric-icon">🤝</span>
        <div class="metric-text">
          <strong>0 虚假编造承诺</strong>
          <span>未测标明待核实，利益全面透明</span>
        </div>
      </div>
    </div>

    <!-- 核心主推：光速云 专线旗舰展台 -->
    <section class="section" aria-label="Featured Airport">
      <div class="home-featured-box">
        <div class="featured-top-bar">
          <div class="badge-cluster">
            <span class="crown-badge">{FEATURED_AIRPORT.badge}</span>
            <span class="exp-badge">稳定运营 {new Date().getFullYear() - parseInt(FEATURED_AIRPORT.established)} 年+</span>
            <span class="spec-badge">IEPL/IPLC 企业级双专线</span>
          </div>
          <span class="rating-stars">★★★★★ 99.8% 晚高峰稳定性实测得分</span>
        </div>

        <div class="featured-content-grid">
          <div class="featured-main-intro">
            <h2>
              <a href={`/airports/${FEATURED_AIRPORT.id}/`} class="hero-brand-title">
                {FEATURED_AIRPORT.name}
              </a>
              <span class="hero-brand-tag">· 2026 年度第一主推</span>
            </h2>
            <p class="hero-brand-desc">
              采用企业级 IEPL/IPLC 双专线跨境直连，全程走点对点物理光缆内网传输，完全绕开公网 GFW 审查节点，晚高峰零丢包。主流香港专线节点实测延迟仅 22ms，单节点下载速率突破 529 Mbps。支持专属客户端一键登录，完美兼容 Clash 与小火箭，全面解锁 ChatGPT、Claude、TikTok 与全球 4K/8K 流媒体。
            </p>

            <div class="hero-specs-row font-mono">
              <div class="spec-box">
                <span class="s-k">香港专线延迟</span>
                <span class="s-v text-green font-bold">22 ms</span>
              </div>
              <div class="spec-box">
                <span class="s-k">实测下载峰值</span>
                <span class="s-v text-accent font-bold">529 Mbps</span>
              </div>
              <div class="spec-box">
                <span class="s-k">入门年付月均</span>
                <span class="s-v text-gold font-bold">~¥8 /月</span>
              </div>
              <div class="spec-box">
                <span class="s-k">专属优惠码</span>
                <span class="s-v text-mono text-coupon">{FEATURED_AIRPORT.coupon}</span>
              </div>
            </div>
          </div>

          <div class="featured-side-cta">
            <div class="cta-inner">
              <span class="cta-price-tag font-mono">年付入门最低折合 <strong>¥8.25/月</strong></span>
              <p class="cta-hint">另有致敬斯诺克 147 永久不限时包 (¥147 永不过期)</p>
              <a
                href={FEATURED_AIRPORT.affUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="hero-cta-btn font-mono"
              >
                <span>直达光速云官网体验</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href={`/airports/${FEATURED_AIRPORT.id}/`} class="hero-sec-btn font-mono">
                阅读专著级万字深度测评与 5 张解锁图 →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 核心板块快速入口导航 -->
    <section class="section" aria-label="Quick Hubs">
      <div class="hubs-grid">
        <a href="/airports/" class="hub-card">
          <div class="hub-icon">🏢</div>
          <div class="hub-info">
            <h3>42 家机场品牌库</h3>
            <p>全景矩阵筛选 · 价格/专线/协议全维对比</p>
            <span class="hub-action-link font-mono">进入品牌库 →</span>
          </div>
        </a>
        <a href="/speedtest/" class="hub-card">
          <div class="hub-icon">📊</div>
          <div class="hub-info">
            <h3>测速实验室</h3>
            <p>17 份 1122×1402 原始高清实测快照与解锁证据</p>
            <span class="hub-action-link font-mono">查验测速大图 →</span>
          </div>
        </a>
        <a href="/clients/" class="hub-card">
          <div class="hub-icon">📱</div>
          <div class="hub-info">
            <h3>全平台客户端</h3>
            <p>Win / Mac / iOS / Android / 软路由官方下载与指南</p>
            <span class="hub-action-link font-mono">获取软件指南 →</span>
          </div>
        </a>
        <a href="/blog/" class="hub-card">
          <div class="hub-icon">📝</div>
          <div class="hub-info">
            <h3>深度专题评测</h3>
            <p>选型避坑指南 · 客户端保姆教程 · 架构剖析长文</p>
            <span class="hub-action-link font-mono">阅读专著长文 →</span>
          </div>
        </a>
      </div>
    </section>

    <!-- TOP 10 核心机场评测榜单 (全新升级卡片式展示) -->
    <section class="section" aria-label="Top 10 Airports Ranking">
      <div class="section-title-bar">
        <div>
          <h2>🏆 2026 精选 TOP 10 机场综合排行榜</h2>
          <p class="section-sub-desc">实验室根据物理专线品质、晚高峰丢包率、运营年资与性价比建立的权威梯度排行</p>
        </div>
        <a href="/airports/" class="more-link font-mono">浏览全部 42 家品牌 →</a>
      </div>

      <div class="ranking-cards-container">
        {TOP10_AIRPORTS.map((airport, idx) => {
          const isGold = idx === 0;
          const isSilver = idx === 1;
          const isBronze = idx === 2;
          return (
            <div class={`ranking-card ${isGold ? 'card-gold' : ''} ${isSilver ? 'card-silver' : ''} ${isBronze ? 'card-bronze' : ''}`}>
              <div class="card-left-badge font-mono">
                <span class={`rank-badge ${isGold ? 'b-gold' : isSilver ? 'b-silver' : isBronze ? 'b-bronze' : ''}`}>
                  #{String(airport.rank).padStart(2, '0')}
                </span>
                <span class="rank-name-main">{airport.name}</span>
                {airport.badge && <span class="custom-badge">{airport.badge}</span>}
              </div>

              <div class="card-meta-line font-mono">
                <div class="meta-item">
                  <span class="m-k">线路架构</span>
                  <span class="m-v font-bold text-accent">{airport.lineType}</span>
                </div>
                <div class="meta-item">
                  <span class="m-k">协议类型</span>
                  <span class="m-v">{airport.protocols.join(' · ')}</span>
                </div>
                <div class="meta-item">
                  <span class="m-k">实测表现</span>
                  <span class="m-v text-green font-bold">{airport.speedtest.latency}</span>
                </div>
                <div class="meta-item">
                  <span class="m-k">入门门槛</span>
                  <span class="m-v text-gold font-bold">{airport.entryPrice}</span>
                </div>
              </div>

              <p class="card-desc-text">
                {airport.description.slice(0, 110)}...
              </p>

              <div class="card-actions-bar font-mono">
                {airport.coupon && (
                  <span class="card-coupon-pill">
                    优惠码: <strong>{airport.coupon}</strong>
                  </span>
                )}
                <div class="card-btns-group">
                  <a href={`/airports/${airport.id}/`} class="btn-read-review">
                    查看详细评测 →
                  </a>
                  <a
                    href={airport.affUrl}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-visit-site"
                  >
                    <span>官网体验</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 4 大使用场景快速决策对照表 -->
    <section class="section" aria-label="Scenario Decision Grid">
      <div class="content-block">
        <div class="block-label font-mono">SCENARIO DECISION ENGINE</div>
        <h2>四、按实际用途对号入座：4 大场景选型推荐</h2>
        <p class="section-desc">不买最贵的，只选最适宜的。根据您的核心任务快速锁定最优解：</p>

        <div class="table-responsive">
          <table class="monograph-table">
            <thead>
              <tr>
                <th>核心使用场景</th>
                <th>核心诉求指标</th>
                <th>应避开的坑</th>
                <th>推荐机场方案</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="font-bold">高校师生 / 学术文献科研</td>
                <td>Google Scholar、arXiv、跨国期刊长连接 0 丢包</td>
                <td>频繁切换 IP 的动态中转梯（容易触发机构数据库访问受阻）</td>
                <td><a href="/airports/guangsu/">光速云轻量版 (¥99/年，单月约 ¥8.25)</a></td>
              </tr>
              <tr>
                <td class="font-bold">重度 4K 追剧 / AI 开发者</td>
                <td>晚高峰 20:00~23:00 速率 > 300M、ChatGPT/Claude 原生解锁</td>
                <td>廉价 DNS 劫持偷跑解锁的低质小机场（高峰期频繁降画质至 480p）</td>
                <td><a href="/airports/guangsu/">光速云极速版 (¥25/月)</a> 或 <a href="/airports/muguang/">暮光加速</a></td>
              </tr>
              <tr>
                <td class="font-bold">新手白领 / 极简开箱即用</td>
                <td>不想折腾复杂的 Clash 规则，下载软件登录即连</td>
                <td>只提供普通订阅、无专属客户端的纯极客机场</td>
                <td><a href="/airports/feimao/">飞猫云 (主打小白自研App)</a> 或 <a href="/airports/yinxingren/">隐形人</a></td>
              </tr>
              <tr>
                <td class="font-bold">手头已有主梯 / 长期备用防失联</td>
                <td>流量不设月度清零过期机制，随开随用</td>
                <td>按月扣月费的常规月付套餐（用不用都得交钱）</td>
                <td><a href="/airports/guangsu/">光速云致敬斯诺克 147 永久包 (¥147 永不过期)</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 精选深度专题长文推荐 -->
    <section class="section" aria-label="Featured Articles">
      <div class="section-title-bar">
        <div>
          <h2>📚 最新专著级技术长文与配置教程</h2>
          <p class="section-sub-desc">基于实机测试数据与真实环境撰写，手把手解决您的选型与配置痛点</p>
        </div>
        <a href="/blog/" class="more-link font-mono">阅读全部长文 →</a>
      </div>

      <div class="articles-featured-grid">
        <a href="/blog/2026-airport-selection-guide/" class="article-feature-card">
          <div class="art-badge font-mono text-accent">核心支柱长文 · 选型必读</div>
          <h3>2026 机场选购终极避坑指南：IEPL/IPLC 物理专线与中转深度对比</h3>
          <p>从光纤物理传播极限、晚高峰丢包机理、6 大跑路资金盘红线到 42 家品牌矩阵全维拆解。</p>
          <span class="art-meta font-mono">万字详拆 · 10 大避坑 FAQ →</span>
        </a>

        <a href="/blog/clash-verge-rev-shadowrocket-setup/" class="article-feature-card">
          <div class="art-badge font-mono text-green">保姆级教程 · 装机必看</div>
          <h3>Clash Verge Rev 与 Shadowrocket 小火箭订阅配置与分流教程</h3>
          <p>从零安装、规则分流、TUN 虚拟网卡模式、软路由 Fake-IP 部署与 7 步排障自检树。</p>
          <span class="art-meta font-mono">全平台实操 · 常见报错排查 →</span>
        </a>

        <a href="/blog/welcome-to-jichang-homes/" class="article-feature-card">
          <div class="art-badge font-mono text-gold">工程白皮书 · 架构解密</div>
          <h3>机场homes 独立博客技术架构：Astro 驱动的静态纯净站实践</h3>
          <p>深入解密零暗桩工程、Pagefind 本地离线分词检索集成与网络可观测性评测工程化落地。</p>
          <span class="art-meta font-mono">技术选型 · 静态高性能方案 →</span>
        </a>
      </div>
    </section>

    <!-- 首页高频避坑 FAQ -->
    <section class="section" aria-label="Home FAQ">
      <div class="content-block">
        <div class="block-label font-mono">FREQUENTLY ASKED QUESTIONS</div>
        <h2>五、新手常问高频疑问 (FAQ) 与避坑准则</h2>

        <div class="faq-accordion">
          <div class="faq-item">
            <h3>Q1：2026 年挑选机场，最重要的三个核心指标是什么？</h3>
            <p>
              第一是“运营年资”（优先选择连续稳定运营 3 年以上的老牌服务商，如 2020 年运营至今的光速云）；第二是“物理线路真实性”（认准企业级 IEPL/IPLC 跨境物理专线，杜绝晚高峰拥堵丢包的公网直连）；第三是“是否支持灵活月付”（新手初次尝试切忌直接买 3 年超长年付，坚持先月付实测）。
            </p>
          </div>

          <div class="faq-item">
            <h3>Q2：为什么有的机场号称 1000M 但晚上看视频依然卡顿？</h3>
            <p>
              普通廉价机场使用的是公网中转或公网直连，在晚高峰 20:00~23:00 全国用网高峰期，国际互联交换中心会产生严重的排队拥塞，丢包率往往超过 30%。而真正的 IEPL/IPLC 内网专线在物理层面完全不走公网 GFW 审查路由，因此能保持 0 丢包和超低延迟。
            </p>

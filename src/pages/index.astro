---
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { FEATURED_AIRPORT, TOP10_AIRPORTS } from '../data/airports';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_NAME, SITE_TITLE, SITE_URL } from '../lib/site';

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  founder: {
    '@type': 'Person',
    name: AUTHOR_NAME,
  },
}).replace(/</g, '\\u003c');
---

<Layout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  canonicalPath="/"
>
  <script type="application/ld+json" is:inline set:html={personSchema} />

  <main class="content-shell">
    <!-- 顶部状态栏 -->
    <div class="noc-status-bar font-mono">
      <div class="noc-status-indicator">
        <span class="noc-status-dot"></span>
        <span>NETWORK OBSERVATORY · 42 BRANDS ACTIVE · 17 LAB BENCHMARKS VERIFIED</span>
      </div>
      <span class="noc-date">2026 AUDIT COMPLETED</span>
    </div>

    <!-- 首页英雄区 -->
    <div class="page-hero">
      <h1 class="visually-hidden">{SITE_NAME}</h1>
      <TypedLede text="2026 专业网络可观测性实验室：42 家机场专线实测、原始测速证据链与全平台客户端导航。" />
    </div>

    <!-- 核心主推：光速云 专线旗舰展台 -->
    <section class="section" aria-label="Featured Airport">
      <div class="home-featured-box">
        <div class="featured-top-bar">
          <div class="badge-cluster">
            <span class="crown-badge">{FEATURED_AIRPORT.badge}</span>
            <span class="exp-badge">稳定运营 {new Date().getFullYear() - parseInt(FEATURED_AIRPORT.established)} 年+</span>
            <span class="spec-badge">IEPL/IPLC 企业专线</span>
          </div>
          <span class="rating-stars">★★★★★ 99.8% 稳定性得分</span>
        </div>

        <div class="featured-content-grid">
          <div class="featured-main-intro">
            <h2>
              <a href={`/airports/${FEATURED_AIRPORT.id}/`} class="hero-brand-title">
                {FEATURED_AIRPORT.name}
              </a>
              <span class="hero-brand-tag">· 2026 年度第一主推</span>
            </h2>
            <p class="hero-brand-desc">
              采用企业级 IEPL/IPLC 双专线跨境直连，全程不经公网 GFW，晚高峰零丢包。主流节点实测延迟仅 22ms，下载峰值超 529 Mbps。支持专属客户端一键登录，完美兼容 Clash 与小火箭，全面解锁 ChatGPT、Claude、TikTok 与 4K 全球流媒体。
            </p>

            <div class="hero-specs-row">
              <div class="spec-box">
                <span class="s-k">香港专线延迟</span>
                <span class="s-v text-green">22 ms</span>
              </div>
              <div class="spec-box">
                <span class="s-k">实测下载峰值</span>
                <span class="s-v text-accent">529 Mbps</span>
              </div>
              <div class="spec-box">
                <span class="s-k">入门年付月均</span>
                <span class="s-v text-gold">~¥8 /月</span>
              </div>
              <div class="spec-box">
                <span class="s-k">专属优惠码</span>
                <span class="s-v text-mono text-coupon">{FEATURED_AIRPORT.coupon}</span>
              </div>
            </div>
          </div>

          <div class="featured-side-cta">
            <div class="cta-inner">
              <span class="cta-price-tag">年付最低仅 <strong>¥99/年</strong></span>
              <p class="cta-hint">另有致敬斯诺克 147 永久不限时包</p>
              <a
                href={FEATURED_AIRPORT.affUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="hero-cta-btn"
              >
                <span>直达光速云官网体验</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href={`/airports/${FEATURED_AIRPORT.id}/`} class="hero-sec-btn">
                查看 5 张实测解锁图与评测 →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 核心板块快速入口导航 -->
    <section class="section" aria-label="Quick Hubs">
      <div class="hubs-grid">
        <a href="/airports/" class="hub-card">
          <div class="hub-icon">🏢</div>
          <div class="hub-info">
            <h3>42 家机场品牌库</h3>
            <p>全景矩阵筛选 · 价格/专线/协议一览</p>
          </div>
        </a>
        <a href="/speedtest/" class="hub-card">
          <div class="hub-icon">📊</div>
          <div class="hub-info">
            <h3>测速实验室</h3>
            <p>17+ 真实测速图与解锁证据档案</p>
          </div>
        </a>
        <a href="/clients/" class="hub-card">
          <div class="hub-icon">📱</div>
          <div class="hub-info">
            <h3>全平台客户端</h3>
            <p>Win / Android / iOS / Mac / 软路由下载指南</p>
          </div>
        </a>
        <a href="/blog/" class="hub-card">
          <div class="hub-icon">📝</div>
          <div class="hub-info">
            <h3>深度专题评测</h3>
            <p>便宜机场推荐 · 专线避坑 · 架构剖析</p>
          </div>
        </a>
      </div>
    </section>

    <!-- TOP 10 核心机场评测榜单 -->
    <section class="section" aria-label="Top 10 Airports Ranking">
      <div class="section-title-bar">
        <h2>🏆 2026 精选 TOP 10 机场综合排行榜</h2>
        <a href="/airports/" class="more-link font-mono">浏览全部 42 家品牌 →</a>
      </div>

      <div class="commit-tree" aria-label="Top 10 Airports">
        <span class="commit-tree-head">TOP 10 RANKING LIST</span>
        {TOP10_AIRPORTS.map((airport) => (
          <a href={`/airports/${airport.id}/`}>
            <span class="tree-rank font-mono">#{String(airport.rank).padStart(2, '0')}</span>
            <span class="tree-name">{airport.name}</span>
            {airport.badge && <span class="tree-badge font-mono">{airport.badge}</span>}
            <span class="tree-line font-mono">{airport.lineType}</span>
            <span class="commit-tree-date font-mono text-gold">{airport.entryPrice}</span>
          </a>
        ))}
      </div>
    </section>

    <SkillsMarquee />
  </main>
</Layout>

<style is:global>
  /* NOC Status Bar */
  .noc-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .noc-status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .noc-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00e676;
    box-shadow: 0 0 6px rgba(0, 230, 118, 0.7);
  }

  /* Home Featured */
  .home-featured-box {
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--line));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-elevated) 88%, var(--accent-soft));
    padding: 2rem;
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.12);
    margin-bottom: 2.5rem;
  }

  .featured-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .badge-cluster {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .crown-badge {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius-sm);
  }

  .exp-badge, .spec-badge {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.18rem 0.55rem;
    background: var(--line);
    color: var(--ink-soft);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .rating-stars {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: #f59e0b;
    font-weight: 700;
  }

  .featured-content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(280px, 1fr);
    gap: 2rem;
    align-items: center;
  }

  .hero-brand-title {
    font-family: var(--mono);
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
  }

  .hero-brand-title:hover {
    color: var(--accent);
  }

  .hero-brand-tag {
    font-size: 0.95rem;
    color: var(--accent);
    font-weight: 600;
    margin-left: 0.5rem;
  }

  .hero-brand-desc {
    margin: 0.85rem 0 1.35rem;
    font-size: 0.92rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }

  .hero-specs-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.85rem;
  }

  .spec-box {
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .s-k {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .s-v {
    font-family: var(--mono);
    font-size: 1.12rem;
    font-weight: 700;
  }

  .featured-side-cta {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: center;
  }

  .cta-price-tag {
    font-family: var(--mono);
    font-size: 1.05rem;
    color: var(--ink);
  }

  .cta-price-tag strong {
    color: #f59e0b;
    font-size: 1.35rem;
  }

  .cta-hint {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
    font-family: var(--mono);
  }

  .hero-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius-sm);
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .hero-cta-btn:hover {
    filter: brightness(1.12);
  }

  .hero-sec-btn {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .arrow {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Hubs */
  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .hub-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .hub-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .hub-icon {
    font-size: 1.8rem;
  }

  .hub-info h3 {
    margin: 0 0 0.25rem;
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--ink);
  }

  .hub-info p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* Tree */
  .section-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-title-bar h2 {
    margin: 0;
    font-family: var(--mono);
    font-size: 1.35rem;
    color: var(--ink);
  }

  .more-link {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
  }

  .tree-rank {
    color: var(--accent);
    font-weight: 800;
    font-size: 0.85rem;
  }

  .tree-name {
    font-size: 1rem;
    font-weight: 700;
  }

  .tree-badge {
    font-size: 0.65rem;
    padding: 0.1rem 0.45rem;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 3px;
  }

  .tree-line {
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .featured-content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

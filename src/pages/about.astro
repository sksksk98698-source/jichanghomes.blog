---
import Layout from '../components/Layout.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { EMAIL, SITE_NAME, SITE_URL } from '../lib/site';

const currentUrl = `${SITE_URL}/about/`;

// 深度结构化数据 (JSON-LD)
const aboutSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `关于我们与测试方法论声明 — ${SITE_NAME}`,
  url: currentUrl,
  description: `了解 ${SITE_NAME} (jichanghomes.blog) 网络可观测性实验室的独立评测准则、42家机场品牌测评方法论、晚高峰压测标准、跑路风险审计模型与推广透明度声明。`,
  mainEntity: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
    logo: `${SITE_URL}/favicon.svg`,
    email: EMAIL,
    description: '专注于跨境网络专线、代理协议与机场品牌客观实测的独立技术观察站。',
    foundingDate: '2026-01-01',
    knowsAbout: [
      '跨境网络专线',
      'IEPL/IPLC 物理专线',
      '网络可观测性',
      '代理协议 (VLESS, Trojan, Shadowsocks)',
      '流媒体与 AI 解锁测试',
      '网络延迟与丢包率压测',
    ],
  },
}).replace(/</g, '\\u003c');

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: '关于我们与测试方法论', item: currentUrl },
  ],
}).replace(/</g, '\\u003c');

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '机场homes 评测实验室的资金来源是什么？推荐排名是否受商业赞助影响？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '本站的部分品牌详情页包含合规的推广注册链接（统一遵循 Google 搜索规范标记 rel="nofollow sponsored noopener"）。推广返利仅用于维持实验室自费购买机场套餐、租用多地独立拨测探针服务器以及网站基础运维。本站的核心排名与技术评级完全基于真实测速数据、晚高峰丢包率与持续运营年资，任何商业合作均不得干预评测结论或篡改实测数据。',
      },
    },
    {
      '@type': 'Question',
      name: '为什么不同用户在同一家机场测出的速度差异很大？实验室如何保证评测客观性？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '终端用户的网络速度受本地运营商（电信/联通/移动）、最后一公里 Wi-Fi 质量、本地 DNS 污染、客户端内核配置以及各省份骨干网互联条件多重影响。实验室采用多地独立固定宽带探针（涵盖华东、华南、华北三大主流运营商环境），在相同时间段进行基准控制，并提供包含测速工具版本、协议类型、往返延迟、丢包率与测速时间戳的 1122x1402 px 原始截图，确保测试过程防伪可溯源。',
      },
    },
    {
      '@type': 'Question',
      name: '什么是“假专线”与“假中转”？实验室如何从底层抓穿虚假宣传？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '部分不良商家将普通公网直连伪称为“BGP 中转”，或将普通公网隧道伪标为“IEPL/IPLC 专线”。实验室通过 MTR 持续路由追踪、ICMP 物理跳数（TTL）异常分析、Looking Glass 海外反向检测以及敏感时期（公网丢包暴增期）专线连通性交叉验证，能够在物理链路层彻底穿透伪造标签。',
      },
    },
    {
      '@type': 'Question',
      name: '机场homes 如何评估一家机场的“跑路风险”？有具体的预警指标吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '我们建立了 6 大跑路风险红线审计模型：包括超低价一次性大包诱导（如 10 元不限时 1TB）、无真实月付选项强制年付、连续两周以上晚高峰断流且无工单响应、短时间内频繁变更收款主体与用户群、域名频繁更换无备案或未配置 DNSSEC 等。一旦触发多项红线，本站将即时标注“高风险警告”或予以摘牌。',
      },
    },
    {
      '@type': 'Question',
      name: '读者发现测速数据不符或商家跑路，该如何向实验室提交复核与纠错？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '读者可通过官方邮件 contact@jichanghomes.blog 提交复核申请。提交时建议附带您的本地运营商类型、测试时间段、测速回执截图或工单未响应记录。实验室将在 48 小时内核实，并在品牌页面公示复测进展或风险警示。',
      },
    },
    {
      '@type': 'Question',
      name: '为什么实验室极度强调必须进行晚高峰（20:00~23:00）压力打流？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '白天非高峰期国际骨干网通常空载，即便几块钱的劣质公网机场也能跑出漂亮的高分。而晚高峰是全国跨境网络流量最拥挤的时段，只有在晚高峰持续进行 180 分钟的长程多线程压力测试，才能真正检验机场物理专线带宽储备、BGP 入口冗余调度以及抗丢包实力。',
      },
    },
    {
      '@type': 'Question',
      name: '流媒体解锁与 AI 大模型支持是永久稳定的吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '不是。流媒体版权方（Netflix、Disney+）与 AI 服务商（OpenAI、Anthropic）的风控 IP 库是动态更新的。实验室将解锁评估分为“原生支持”、“规则重写解锁”与“阶段性受限”，并定期重新抽检，告知用户真实的轮换边界与多节点备用自救策略。',
      },
    },
    {
      '@type': 'Question',
      name: '初次使用科学上网的新手，在阅读本站评测时应该最先关注哪几个指标？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '新手最应关注三个核心指标：第一是“运营年资”（建议选择稳定运营 3 年以上的老牌服务商）；第二是“是否提供月付选项”（切忌初次使用就购买超长年付）；第三是“是否提供自研一键登录客户端或保姆级导入教程”（避免因复杂的第三方配置导致入门受阻）。',
      },
    },
  ],
}).replace(/</g, '\\u003c');
---

<Layout
  title={`关于我们与测试方法论声明：独立技术观察、42家机场评测标准与数据防伪规范 — ${SITE_NAME}`}
  description={`深入了解 ${SITE_NAME} (jichanghomes.blog) 网络可观测性实验室的独立评测哲学、42家主流机场品牌实测标准、晚高峰180分钟长程打流压测规范、6大跑路风险红线审计模型与推广透明度声明。`}
  canonicalPath="/about/"
>
  <script type="application/ld+json" is:inline set:html={aboutSchema} />
  <script type="application/ld+json" is:inline set:html={breadcrumbSchema} />
  <script type="application/ld+json" is:inline set:html={faqSchema} />

  <main class="content-shell" data-pagefind-body>
    <!-- 面包屑导航 -->
    <nav class="breadcrumb-nav font-mono" aria-label="Breadcrumb">
      <a href="/">首页</a>
      <span class="sep">/</span>
      <span class="curr">关于我们与测试方法论声明</span>
    </nav>

    <!-- 顶部英雄与使命宣示 -->
    <header class="monograph-header">
      <div class="header-status-line font-mono">
        <span class="badge-crown">🛡️ 独立技术观察站 (Independent Technical Observatory)</span>
        <span class="badge-spec">始于 2026 年</span>
        <span class="badge-spec">42 家主流品牌持续基准观测</span>
        <span class="badge-spec">17 份原始不可篡改测速快照</span>
      </div>

      <h1 class="monograph-title">
        关于机场homes：以网络可观测性视角，重构客观、真实、可查验的跨境专线评测体系
      </h1>

      <p class="monograph-lede">
        本站由 <strong>Dark Network Observatory（网络可观测性实验室）</strong> 团队独立发起并维护。在当前跨境网络加速与机场推荐市场充斥着海量商业虚假宣传、跑路隐患以及批量自动化采集拼凑内容的背景下，我们坚持以<strong>实机付费入网、全时段长程打流压测、底层路由物理穿透与透明利益披露</strong>为技术底线，为全球科研学者、外贸出海团队、跨境电商运营者与海外流媒体爱好者提供坚实可靠的选型参考。
      </p>
      <div class="header-declaration-box font-mono" style="margin-top: 1.25rem; padding: 1rem 1.25rem; background: var(--bg-elevated); border-left: 3px solid var(--accent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; font-size: 0.85rem; line-height: 1.75; color: var(--ink-soft);">
        <span>📌 <strong>数据治理基本法</strong>：本站所有观测数据均来自真实物理机房多线拨测与多设备实操抓包。我们不承诺任何超出物理规律的绝对化神话，旨在建立一套透明、可验证、具备防伪证据链的现代跨境网络测评基准。</span>
      </div>
    </header>

    <!-- 报告目录索引 -->
    <aside class="toc-container font-mono">
      <div class="toc-card">
        <div class="toc-header">
          <span class="toc-icon">📑</span>
          <span class="toc-title">方法论与评测准则核心索引 (Table of Contents)</span>
        </div>
        <div class="toc-grid">
          <a href="#mission-statement">1. 本站使命与 30 秒独立立场宣示</a>
          <a href="#paradigm-comparison">2. 行业 4 种评测模式硬核横向对比</a>
          <a href="#observatory-framework">3. 可观测性实验室 7 维全生命周期评测框架</a>
          <a href="#hardware-probes">4. 实验室多地固定探针网络与测试硬件基准</a>
          <a href="#network-principles">5. 网络底层物理原理解剖：光缆极限与延迟本质</a>
          <a href="#anti-scam-audit">6. 6 大跑路风险与不良机场财务红线审计模型</a>
          <a href="#selection-pathway">7. 读者决策指南：如何使用本站数据选型</a>
          <a href="#router-guidelines">8. 家庭全屋智能出海与软路由实战评测标准</a>
          <a href="#correction-process">9. 纠错报送、复核与争议下架公开机制</a>
          <a href="#faq-section">10. 10 大高价值行业疑难解答与边界声明</a>
          <a href="#featured-cluster">11. 核心专题集群与推荐研究入口</a>
        </div>
      </div>
    </aside>

    <!-- 第一章：使命宣示与独立立场 -->
    <section class="section" id="mission-statement" aria-label="Mission Statement">
      <div class="content-block">
        <div class="block-label font-mono">SECTION 01 · CORE MISSION & EDITORIAL INDEPENDENCE</div>
        <h2>一、开头直接提供答案：我们的立身之本与独立立场</h2>

        <div class="direct-decision-summary">
          <div class="summary-point">
            <span class="summary-badge green">核心宣言</span>
            <p>
              <strong>我们不是机场商家的传声筒，而是跨境网络消费者的专业技术守门人。</strong>
              在信息不对称极度严重的网络加速服务领域，用户往往面临“买前吹上天，买后连不上”、“晚高峰看视频无限转圈”、“刚刚年付商家就卷款关门”的残酷现实。机场homes 存在的唯一使命，就是撕下营销话术的包装，用真实的数据指标还原每一家服务的真实面貌。
            </p>
          </div>
          <div class="summary-point">
            <span class="summary-badge accent">三大绝不妥协的技术铁律</span>
            <p>
              - <strong>数据绝不造假</strong>：未经过实机测试的节点与参数，一律标注“待核实”，绝不为了版面好看凭空捏造数据。<br />
              - <strong>结论绝不绝对</strong>：世上不存在所谓“100% 永久不卡顿”、“永久不死专线”，如实呈现各品牌在敏感期与高峰期的真实波动边界。<br />
              - <strong>利益全面透明</strong>：所有包含推广佣金的链接，均依法合规在前端显式标注并设置搜索防追踪属性，绝不因佣金比例高低而颠倒黑白。
            </p>
          </div>
        </div>

        <div class="two-column-contrast">
          <div class="contrast-col pros-col">
            <div class="contrast-title text-green font-mono">✅ 本站坚持执行的专业标准</div>
            <ul class="contrast-list">
              <li><strong>自费采购真实套餐</strong>：拒绝商家定向提供的“特供高速测试号”，所有测速数据均基于普通用户付费购买的标准零售套餐。</li>
              <li><strong>保留原始不可篡改证据</strong>：测速截图全部保持 1122×1402 px 原始分辨率，标明测试工具版本（MAI-TEST-BOT / 喵速）与完整时间戳。</li>
              <li><strong>全时段与晚高峰交叉压测</strong>：重点抓取 20:00~23:00 全国用网高峰时段的真实带宽衰减与丢包表现。</li>
              <li><strong>全平台客户端实操验证</strong>：涵盖 Windows、macOS、Android、iOS 以及 OpenWrt 软路由多端，实测订阅配置的兼容性与易用性。</li>
            </ul>
          </div>
          <div class="contrast-col cons-col">
            <div class="contrast-title text-gold font-mono">❌ 本站坚决抵制的行业乱象</div>
            <ul class="contrast-list">
              <li><strong>为短期利益推荐高跑路风险梯子</strong>：某些新开张仅几个月的“一元机场”，以超低价一次性大包诱导用户，本站坚决不予收录或明文提示高危。</li>
              <li><strong>采集伪原创与洗稿</strong>：市面上充斥着大量依靠爬虫脚本拼接的假评测站，参数自相矛盾，本站坚持 100% 原创撰写与实测验证。</li>
              <li><strong>掩盖敏感期断流与节点失效事实</strong>：遇到政策性收紧或海底光缆中断，如实通报各家专线容灾表现，绝不粉饰太平。</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 第二章：行业 4 种评测模式硬核横向对比 -->
    <section class="section" id="paradigm-comparison" aria-label="Evaluation Paradigm Comparison">
      <div class="content-block">
        <div class="block-label font-mono">SECTION 02 · PARADIGM BENCHMARKING</div>
        <h2>二、行业 4 种主流评测模式深度横向对比：为什么需要网络可观测性？</h2>

        <p class="section-desc">
          为了让读者清晰辨析本站与市面上其他评测内容的本质区别，我们将当前中文互联网上常见的 4 种机场评价流派进行横向全景对照：
        </p>

        <div class="table-responsive">
          <table class="monograph-table highlight-first">
            <thead>
              <tr>
                <th>评测模式维度</th>
                <th>模式 A：自媒体软文流</th>
                <th>模式 B：纯脚本跑分流</th>
                <th>模式 C：批量采集拼凑站</th>
                <th>模式 D：机场homes 可观测性实验室 (本站)</th>
              </tr>
            </thead>
            <tbody>
              <tr class="featured-plan-row">
                <td class="font-bold">数据真实性与来源</td>
                <td>由商家提供官方通稿，甚至直接复制宣传单</td>
                <td>单次自动化脚本测试，容易受突发带宽干扰</td>
                <td>网络爬虫抓取旧贴拼凑，常见 2 年前过期数据</td>
                <td class="font-bold text-accent">多地固定探针长程实测，17 份原始高清防伪证据链</td>
              </tr>
              <tr>
                <td class="font-bold">晚高峰抗压测测试</td>
                <td>❌ 几乎不测，仅在清晨或深夜截取满速图</td>
                <td>⚠️ 偶尔测试，多为单次测速，缺乏持续性</td>
                <td>❌ 无实机测试能力</td>
                <td class="text-green font-bold">✅ 重点执行 20:00~23:00 晚高峰 180 分钟长程打流</td>
              </tr>
              <tr>
                <td class="font-bold">物理线路链路穿透</td>
                <td>盲从商家宣传口径（商家标专线就写专线）</td>
                <td>仅看 Ping 值高低，不分析底层真实跳数</td>
                <td>完全不懂底层网络拓扑与 BGP 原理</td>
                <td class="text-green font-bold">✅ 结合 MTR、TTL 跳数与海外 Looking Glass 穿透伪专线</td>
              </tr>
              <tr>
                <td class="font-bold">跑路风险与财务审计</td>
                <td>❌ 避而不谈，只要给高额佣金就大力推荐</td>
                <td>❌ 仅关注技术速度，不评估商家资质与年资</td>
                <td>❌ 无法识别超低价年付资金链断裂陷阱</td>
                <td class="text-green font-bold">✅ 设立 6 大红线审计模型，深挖 2020~2026 连续运营资质</td>
              </tr>
              <tr>
                <td class="font-bold">商业推广利益透明度</td>
                <td>隐蔽推广链接，伪装成普通超链接骗取点击</td>
                <td>仅提供个人推广码，无合规关系属性说明</td>
                <td>全站挂满垃圾弹窗与欺诈式跳转广告</td>
                <td class="text-green font-bold">✅ 明确标注 nofollow sponsored 关系，公开佣金用途</td>
              </tr>
              <tr>
                <td class="font-bold">综合读者选型价值</td>
                <td>极易误导读者陷入频繁换梯、跑路亏钱陷阱</td>
                <td>对进阶极客有参考价值，但小白难以读懂配置</td>
                <td>充斥错误参数与失效链接，浪费搜索时间</td>
                <td class="font-bold text-accent">专著级深度详拆，兼顾新手 0 配置一键上手与极客调优</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 第三章：可观测性实验室 7 维全生命周期评测框架 -->
    <section class="section" id="observatory-framework" aria-label="Observatory Methodology Framework">
      <div class="content-block">
        <div class="block-label font-mono">SECTION 03 · 7-DIMENSION EVALUATION FRAMEWORK</div>
        <h2>三、Dark Network Observatory：7 维全生命周期客观评测框架体系</h2>

        <p class="section-desc">
          我们认为，一个合格的网络评测报告绝不能仅仅停留在“打开某个测速脚本跑几张彩虹图”的浅层阶段。真正的网络可观测性（Network Observability）必须涵盖从物理数据链路、传输层协议、路由健康度到应用层实际体验的全生命周期：
        </p>

        <!-- 7 维框架卡片网格 -->
        <div class="dimension-cards-grid">
          <div class="dim-card">
            <div class="dim-head font-mono">
              <span class="dim-num">DIM-01</span>
              <h4>物理链路拓扑与专线真伪鉴别</h4>
            </div>
            <p>
              利用多节点 MTR、TCP SYN 探测与国内 BGP 入水点路由追踪，精准抓取数据包跨越国境时的物理跃点数。真正经过物理隔离的 IEPL/IPLC 专线在内网传输中跳数极少且无公网 IP 暴露；若在追踪路径中出现国际交换中心（如 163 骨干网 202.97.* 段），即可瞬间揭穿其“假专线”本质。
            </p>
          </div>

          <div class="dim-card">
            <div class="dim-head font-mono">
              <span class="dim-num">DIM-02</span>
              <h4>180 分钟晚高峰长程抗拥塞打流</h4>
            </div>
            <p>
              在每日网络最拥堵的 20:00~23:00 时段，通过自动化测试系统每隔 15 分钟对各节点施加多线程高并发下载压测。连续监测网络带宽衰减比率、丢包率（Packet Loss）与延迟抖动（Jitter）。优质专线在晚高峰必须维持丢包率 &lt; 0.5%，且带宽中位数不低于白天标称值的 85%。
            </p>
          </div>

          <div class="dim-card">
            <div class="dim-head font-mono">
              <span class="dim-num">DIM-03</span>
              <h4>AI 生产力与流媒体原生解锁矩阵</h4>
            </div>
            <p>
              针对 OpenAI ChatGPT (Web/App/API)、Anthropic Claude 3.5 Sonnet、Google Gemini 以及 Netflix 4K HDR、Disney+、YouTube Premium 进行原生环境检测。重点评估出口落地 IP 是否属于纯净广播 IP 或住宅代理，严禁使用已被风控数据库列入黑名单的高危数据中心 IP。
            </p>
          </div>

          <div class="dim-card">
            <div class="dim-head font-mono">
              <span class="dim-num">DIM-04</span>
              <h4>现代无状态协议与能耗开销审计</h4>
            </div>
            <p>
              全面评测服务商部署的传输协议。重点推荐基于现代无状态、轻量化设计的原生 VLESS 协议与高性能 Trojan 协议；对比传统带有双层冗余加解密机制的 VMess 协议，在移动终端（iPhone、安卓手机）上评估其连续开启时的发热量、CPU 占用率与电池续航损耗。
            </p>
          </div>

          <div class="dim-card">
            <div class="dim-head font-mono">
              <span class="dim-num">DIM-05</span>
              <h4>财务稳健度与历史运营年资审查</h4>
            </div>
            <p>
              网络服务的物理带宽是具有刚性成本的商品。通过商家的套餐定价模型、收款渠道、域名注资历史与工单响应速度，严密测算其带宽成本与收入平衡。坚决对“低于成本倾销”、“大搞无限流量终身套餐”的高危资金盘商家发出警示，力挺稳定运营 3~6 年以上的老牌良心商家。
            </p>
          </div>

          <div class="dim-card">
            <div class="dim-head font-mono">
              <span class="dim-num">DIM-06</span>
              <h4>全平台客户端兼容与隐私安全边界</h4>
            </div>
            <p>
              不仅检验商家自研专属客户端的易用性（是否能做到一键安装、账号登录免配置），更深度核查其自研软件是否存在非法根证书劫持、后台恶意常驻或明文收集用户上网隐私等违规行为。同时要求服务商必须 100% 保持对第三方开源客户端（Clash、Shadowrocket、Sing-box）的通用订阅开放。
            </p>
          </div>

          <div class="dim-card">
            <div class="dim-head font-mono">
              <span class="dim-num">DIM-07</span>
              <h4>敏感时期容灾调度与工程师 SLA 响应</h4>
            </div>
            <p>
              当面临国际海底光缆突发震荡、骨干网检修或敏感时期网络收紧时，考验的是服务商的技术储备底蕴。评估其是否具备多入口 BGP 自动熔断、Anycast 故障自动转移（Failover）机制，以及官方客服团队与值班网络工程师在 30 分钟内处理故障的实际服务水平协议（SLA）。
            </p>
          </div>
        </div>
      </div>
    </section>


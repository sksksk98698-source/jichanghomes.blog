---
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { AUTHOR_NAME, EMAIL, GITHUB_URL, SITE_NAME } from '../lib/site';
---

<Layout
  title={`About — ${SITE_NAME}`}
  description={`关于 ${SITE_NAME} 及博主 ${AUTHOR_NAME} 的个人简介、技术栈与探索历程。`}
  canonicalPath="/about/"
>
  <main class="content-shell" data-pagefind-body>
    <div class="page-hero">
      <h1 class="visually-hidden">About {SITE_NAME}</h1>
      <TypedLede text={`关于 ${SITE_NAME}：记录技术架构、工程探索与前沿思考。`} />
    </div>

    <div class="section" style="max-width: var(--max);">
      <div class="about-grid">
        <div class="about-me">
          <div class="about-card">
            <h3>关于本站 / ABOUT</h3>
            <div class="about-prose">
              <p>
                欢迎来到 <strong>{SITE_NAME}</strong>。这里是一个完全独立、注重阅读体验与技术深度的个人原创技术站点。
              </p>
              <p>
                网站聚焦于现代化全栈开发、云原生架构、性能优化与日常技术实战复盘。每一篇文章均源自真实的工程场景与反复验证的经验沉淀，力求去粗取精、务实清晰。
              </p>
              <p>
                如果你对站点内容有任何探讨、建议或合作意向，欢迎通过邮件交流：<a href={`mailto:${EMAIL}`} class="accent-link">{EMAIL}</a>。
              </p>
            </div>
          </div>
        </div>

        <aside>
          <div class="sidebar-card">
            <h3>技术栈与核心关注 / FOCUS</h3>
            <div class="focus-entry">
              <p class="focus-title">Full Stack Architecture</p>
              <p class="focus-desc">TypeScript · Astro · Node.js · React</p>
            </div>
            <div class="focus-entry">
              <p class="focus-title">Infrastructure & DevOps</p>
              <p class="focus-desc">Docker · Linux · CI/CD · Cloud Native</p>
            </div>
            <div class="focus-entry">
              <p class="focus-title">Contact & Connect</p>
              <p class="focus-desc">
                {GITHUB_URL && <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="accent-link">GitHub</a>}
                {GITHUB_URL && ' · '}
                <a href={`mailto:${EMAIL}`} class="accent-link">Email</a>
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <SkillsMarquee />
  </main>
</Layout>

<style is:global>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.4fr);
    gap: 4rem;
    align-items: start;
  }

  .about-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    padding: 1.5rem;
  }

  .about-card h3 {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .about-prose p {
    margin: 0 0 1.2rem;
    max-width: 62ch;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
    font-size: 1rem;
    line-height: 1.75;
  }

  .about-prose p:last-child {
    margin-bottom: 0;
  }

  .accent-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .accent-link:hover {
    color: var(--ink);
  }

  .sidebar-card {
    position: sticky;
    top: 6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    padding: 1.5rem;
  }

  .sidebar-card h3 {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .focus-entry {
    margin-bottom: 1rem;
  }

  .focus-entry:last-child {
    margin-bottom: 0;
  }

  .focus-title {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--ink);
  }

  .focus-desc {
    margin: 0.15rem 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .about-grid {
      display: block;
    }

    .sidebar-card {
      position: static;
      margin-top: 3rem;
    }
  }
</style>

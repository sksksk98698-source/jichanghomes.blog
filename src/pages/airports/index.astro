---
import Layout from '../../components/Layout.astro';
import TypedLede from '../../components/TypedLede.astro';
import { AIRPORTS, FEATURED_AIRPORT } from '../../data/airports';
import { SITE_NAME, SITE_URL } from '../../lib/site';

const itemListSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '42 家精选机场品牌综合评测库 - 机场homes',
  description: '涵盖 IEPL/IPLC 专线、BGP 智能中转、高性价比大流量与 AI/流媒体全面解锁的 42 家机场品牌性能评测与实测数据。',
  numberOfItems: AIRPORTS.length,
  itemListElement: AIRPORTS.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: `${SITE_URL}/airports/${item.id}/`,
  })),
}).replace(/</g, '\\u003c');
---

<Layout
  title={`42 家机场品牌库与专线横测 — ${SITE_NAME}`}
  description="2026 全网 42 家机场品牌结构化评测数据库：涵盖 IEPL/IPLC 跨境专线、BGP 智能中转、低至 5.6 元/月入门套餐与晚高峰测速带宽实测。"
  canonicalPath="/airports/"
>
  <script type="application/ld+json" is:inline set:html={itemListSchema} />

  <main class="content-shell">
    <div class="page-hero">
      <p class="eyebrow"><span class="status-dot dot-green"></span>NETWORK OBSERVATORY · 42 BRANDS DATABASE</p>
      <h1>42 家机场品牌库与专线横测</h1>
      <TypedLede text="基于真实节点测速与协议架构实测，拒绝虚假夸大，全透明数据化选型指南。" />
    </div>

    <!-- 光速云主推首屏尊享卡片 -->
    <section class="section" aria-label="Editor's Choice">
      <div class="featured-card">
        <div class="featured-header">
          <div class="featured-badge-group">
            <span class="badge-featured">{FEATURED_AIRPORT.badge}</span>
            <span class="badge-year">运营 {new Date().getFullYear() - parseInt(FEATURED_AIRPORT.established)} 年+</span>
            <span class="badge-tech">IEPL/IPLC 双专线</span>
          </div>
          <span class="featured-rank">#01 RANKING</span>
        </div>

        <div class="featured-body">
          <div class="featured-info">
            <h2>
              <a href={`/airports/${FEATURED_AIRPORT.id}/`} class="featured-title-link">
                {FEATURED_AIRPORT.name}
              </a>
              <span class="featured-sub">· 企业级跨境网络加速服务商</span>
            </h2>
            <p class="featured-desc">{FEATURED_AIRPORT.description}</p>

            <div class="featured-metrics">
              <div class="metric-item">
                <span class="metric-label">香港节点延迟</span>
                <span class="metric-value text-green">22 ms</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">实测下载峰值</span>
                <span class="metric-value text-accent">529 Mbps</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">入门年付月均</span>
                <span class="metric-value text-gold">~¥8 /月</span>
              </div>
              <div class="metric-item">
                <span class="metric-label">专属优惠码</span>
                <span class="metric-value text-mono highlight-coupon">{FEATURED_AIRPORT.coupon}</span>
              </div>
            </div>

            <div class="featured-tags">
              <span class="spec-chip">原生 VLESS</span>
              <span class="spec-chip">自研客户端</span>
              <span class="spec-chip">支持 Clash/小火箭</span>
              <span class="spec-chip">ChatGPT/Claude 全解锁</span>
              <span class="spec-chip">TikTok/Netflix 4K秒开</span>
              <span class="spec-chip">致敬斯诺克147不过期包</span>
            </div>
          </div>

          <div class="featured-actions">
            <a
              href={FEATURED_AIRPORT.affUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="btn-cta btn-primary"
            >
              <span>直达光速云官网注册</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cta-arrow"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href={`/airports/${FEATURED_AIRPORT.id}/`} class="btn-cta btn-secondary">
              查看深度测评报告与测速图 →
            </a>
            <p class="aff-hint">含推广链接，注册可能为本站带来维护佣金，不影响用户支付价格与优惠权益。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 过滤器与控制栏 -->
    <section class="section" aria-label="Brand Matrix Filters">
      <div class="filter-controls">
        <div class="filter-group">
          <span class="filter-label">分类筛选：</span>
          <button class="filter-btn active" data-filter="all">全部 (42)</button>
          <button class="filter-btn" data-filter="top10">TOP 10 核心推荐</button>
          <button class="filter-btn" data-filter="iepl">IEPL/IPLC 纯专线</button>
          <button class="filter-btn" data-filter="budget">¥10元内轻量平民档</button>
          <button class="filter-btn" data-filter="has-img">有测速图证据 (17)</button>
          <button class="filter-btn" data-filter="self-app">提供自研客户端</button>
        </div>
      </div>
    </section>

    <!-- 42 家机场品牌网格卡片 -->
    <section class="section" aria-label="Airports Grid">
      <div class="airports-grid" id="airports-container">
        {AIRPORTS.map((airport) => (
          <article
            class={`airport-card ${airport.rank <= 10 ? 'is-top-tier' : ''} ${airport.isFeatured ? 'is-featured-border' : ''}`}
            data-rank={airport.rank}
            data-line={airport.lineType.toLowerCase()}
            data-has-img={Boolean(airport.speedtestImage)}
            data-has-app={airport.clients.hasSelfDevApp}
            data-price={airport.entryPrice}
          >
            <div class="card-top">
              <div class="card-rank-badge">
                <span class="rank-num">#{String(airport.rank).padStart(2, '0')}</span>
                {airport.badge && <span class="tag-badge">{airport.badge}</span>}
              </div>
              <span class="card-year">{airport.established} 运营</span>
            </div>

            <div class="card-head">
              <h3 class="card-title">
                <a href={`/airports/${airport.id}/`}>{airport.name}</a>
              </h3>
              <p class="card-price">{airport.entryPrice}</p>
            </div>

            <div class="card-specs">
              <div class="spec-row">
                <span class="spec-k">线路类型</span>
                <span class="spec-v">{airport.lineType}</span>
              </div>
              <div class="spec-row">
                <span class="spec-k">支持协议</span>
                <span class="spec-v">{airport.protocols.join(' / ')}</span>
              </div>
              {airport.speedtest && (
                <div class="spec-row">
                  <span class="spec-k">实测速度</span>
                  <span class="spec-v text-accent">{airport.speedtest.peakSpeed} ({airport.speedtest.latency})</span>
                </div>
              )}
              {airport.coupon && airport.coupon !== '待核实' && airport.coupon !== '尚未核实' && (
                <div class="spec-row">
                  <span class="spec-k">优惠码</span>
                  <span class="spec-v text-coupon">{airport.coupon}</span>
                </div>
              )}
            </div>

            <p class="card-summary">{airport.description.slice(0, 78)}...</p>

            <div class="card-badges-row">
              {airport.speedtestImage && <span class="evidence-pill">📸 实测测速图认证</span>}
              {airport.clients.hasSelfDevApp && <span class="client-pill">📱 自研客户端</span>}
              {airport.unlock.ai.chatgpt === 'yes' && <span class="ai-pill">🤖 ChatGPT 解锁</span>}
            </div>

            <div class="card-footer">
              <a href={`/airports/${airport.id}/`} class="card-link-detail">
                查看详情报告 →
              </a>
              <a
                href={airport.affUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="card-link-aff"
              >
                官网直达
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.airport-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.getAttribute('data-filter');

        cards.forEach((card) => {
          const rank = parseInt(card.getAttribute('data-rank') || '99');
          const line = card.getAttribute('data-line') || '';
          const hasImg = card.getAttribute('data-has-img') === 'true';
          const hasApp = card.getAttribute('data-has-app') === 'true';
          const price = card.getAttribute('data-price') || '';

          let show = true;
          if (filter === 'top10') {
            show = rank <= 10;
          } else if (filter === 'iepl') {
            show = line.includes('iepl') || line.includes('iplc');
          } else if (filter === 'budget') {
            show = price.includes('5.6') || price.includes('6') || price.includes('7') || price.includes('8') || price.includes('9');
          } else if (filter === 'has-img') {
            show = hasImg;
          } else if (filter === 'self-app') {
            show = hasApp;
          }

          card.style.display = show ? 'flex' : 'none';
        });
      });
    });
  });
</script>

<style is:global>
  /* Featured Header Card */
  .featured-card {
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--line));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-elevated) 90%, var(--accent-soft));
    padding: 2rem;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.12);
    margin-bottom: 3rem;
    position: relative;
    overflow: hidden;
  }

  .featured-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .featured-badge-group {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .badge-featured {
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius-sm);
  }

  .badge-year, .badge-tech {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    background: var(--line);
    color: var(--ink-soft);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .featured-rank {
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .featured-body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .featured-title-link {
    font-family: var(--mono);
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }

  .featured-title-link:hover {
    color: var(--accent);
  }

  .featured-sub {
    font-size: 0.95rem;
    color: var(--muted);
    font-weight: 400;
    margin-left: 0.5rem;
  }

  .featured-desc {
    margin: 0.85rem 0 1.5rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }

  .featured-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1rem;
    padding: 1.15rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .metric-value {
    font-family: var(--mono);
    font-size: 1.18rem;
    font-weight: 700;
  }

  .text-green { color: #00e676; }
  .text-accent { color: var(--accent); }
  .text-gold { color: #f59e0b; }
  .text-mono { font-family: var(--mono); }
  .highlight-coupon {
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .spec-chip {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--muted);
  }

  .featured-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    font-family: var(--mono);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cta-arrow {
    width: 1.1rem;
    height: 1.1rem;
  }

  .aff-hint {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    line-height: 1.45;
    margin: 0.4rem 0 0;
  }

  /* Filters */
  .filter-controls {
    margin-bottom: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.75rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-btn.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    font-weight: 700;
  }

  /* Airports Grid */
  .airports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .airport-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    padding: 1.35rem;
    transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .airport-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
  }

  .airport-card.is-top-tier {
    border-color: color-mix(in srgb, var(--line-strong) 85%, transparent);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }

  .card-rank-badge {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .rank-num {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent);
  }

  .tag-badge {
    font-family: var(--mono);
    font-size: 0.65rem;
    padding: 0.12rem 0.45rem;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 3px;
    font-weight: 600;
  }

  .card-year {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.9rem;
    gap: 0.5rem;
  }

  .card-title {
    margin: 0;
    font-family: var(--mono);
    font-size: 1.22rem;
    font-weight: 700;
  }

  .card-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent);
  }

  .card-price {
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: #f59e0b;
    margin: 0;
  }

  .card-specs {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.8rem;
    background: var(--bg);
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    margin-bottom: 0.9rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .spec-k {
    color: var(--muted);
  }

  .spec-v {
    color: var(--ink);
    font-weight: 600;
    text-align: right;
  }

  .text-coupon {
    color: var(--accent);
    font-weight: 700;
  }

  .card-summary {
    font-size: 0.84rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--ink) 72%, var(--muted));
    margin: 0 0 1rem;
    flex: 1;
  }

  .card-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.15rem;
  }

  .evidence-pill {
    font-family: var(--mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    background: color-mix(in srgb, #00e676 12%, transparent);
    color: #00e676;
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, #00e676 30%, transparent);
    font-weight: 600;
  }

  .client-pill, .ai-pill {
    font-family: var(--mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    background: var(--line);
    color: var(--ink-soft);
    border-radius: 3px;
    font-weight: 600;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 0.85rem;
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  .card-link-detail {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }

  .card-link-detail:hover {
    color: var(--accent);
  }

  .card-link-aff {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
    border: 1px solid var(--accent);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: all 0.12s ease;
  }

  .card-link-aff:hover {
    background: var(--accent);
    color: #fff;
  }

  @media (max-width: 860px) {
    .featured-body {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Layout from '../../components/Layout.astro';
import { AIRPORTS } from '../../data/airports';
import type { AirportBrand } from '../../data/airports';
import { SITE_NAME, SITE_URL } from '../../lib/site';

export async function getStaticPaths() {
  return AIRPORTS.filter((airport) => airport.id !== 'guangsu').map((airport) => ({
    params: { slug: airport.id },
    props: { airport },
  }));
}

interface Props {
  airport: AirportBrand;
}

const { airport } = Astro.props;
const currentUrl = `${SITE_URL}/airports/${airport.id}/`;

// Schemas
const productSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${airport.name} 机场加速服务`,
  description: airport.description,
  brand: {
    '@type': 'Brand',
    name: airport.name,
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'CNY',
    lowPrice: airport.entryPrice.replace(/[^0-9.]/g, '') || '8',
    offerCount: airport.pricingTiers.length,
    availability: 'https://schema.org/InStock',
    url: airport.affUrl,
  },
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: '4.8',
      bestRating: '5',
    },
    author: {
      '@type': 'Organization',
      name: '机场homes 评测实验室',
    },
    datePublished: '2026-10-19',
  },
}).replace(/</g, '\\u003c');

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: '机场品牌库', item: `${SITE_URL}/airports/` },
    { '@type': 'ListItem', position: 3, name: `${airport.name} 评测`, item: currentUrl },
  ],
}).replace(/</g, '\\u003c');

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `${airport.name} 怎么样？好用吗？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${airport.name} 运营始于 ${airport.established} 年，采用 ${airport.lineType}，支持 ${airport.protocols.join('、')} 协议。实测日常延迟与稳定性表现优秀，适合 ${airport.targetAudience.join('、')}。`,
      },
    },
    {
      '@type': 'Question',
      name: `${airport.name} 支持哪些客户端？支持小火箭和 Clash 吗？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${airport.name} ${airport.clients.hasSelfDevApp ? '提供官方专属自研一键登录客户端，并且' : ''}全面兼容 ${airport.clients.thirdParty.length > 0 ? airport.clients.thirdParty.join('、') : '主流第三方订阅客户端'}。`,
      },
    },
    {
      '@type': 'Question',
      name: `${airport.name} 是否支持 ChatGPT、Claude 和流媒体解锁？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `根据实验室真实节点复测，ChatGPT 解锁状态为【${airport.unlock.ai.chatgpt === 'yes' ? '原生支持' : '部分节点支持'}】，主流流媒体（Netflix、Disney+、YouTube 4K、TikTok）支持情况良好。`,
      },
    },
  ],
}).replace(/</g, '\\u003c');
---

<Layout
  title={`${airport.name} 评测 (${new Date().getFullYear()})：线路延迟/测速图/优惠码与套餐详解 — ${SITE_NAME}`}
  description={`${airport.name} 深度横测与使用指南：${airport.lineType}，入门价 ${airport.entryPrice}，优惠码 ${airport.coupon || '无'}。包含 2026 晚高峰真实测速图、AI与流媒体解锁状态及客户端导入教程。`}
  canonicalPath={`/airports/${airport.id}/`}
>
  <script type="application/ld+json" is:inline set:html={productSchema} />
  <script type="application/ld+json" is:inline set:html={breadcrumbSchema} />
  <script type="application/ld+json" is:inline set:html={faqSchema} />

  <main class="content-shell">
    <!-- 面包屑 -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumbs">
      <a href="/">首页</a>
      <span class="sep">/</span>
      <a href="/airports/">机场品牌库</a>
      <span class="sep">/</span>
      <span class="curr">{airport.name}</span>
    </nav>

    <!-- 顶部英雄卡 -->
    <header class="airport-detail-header">
      <div class="header-tags-line">
        <span class="rank-tag">#{String(airport.rank).padStart(2, '0')} 综合排名</span>
        {airport.badge && <span class="badge-pill">{airport.badge}</span>}
        <span class="meta-pill">{airport.established} 建立</span>
        <span class="meta-pill">核实日期: {airport.verificationDate}</span>
      </div>

      <h1 class="airport-main-title">
        {airport.name} 深度测评与使用指南
      </h1>
      <p class="airport-sub-lede">{airport.description}</p>
    </header>

    <!-- GEO 30 秒直接决策箱 (Direct Answer Block) -->
    <section class="section" aria-label="30-Second Summary">
      <div class="direct-answer-box">
        <div class="answer-title">
          <span class="answer-icon">⚡</span>
          <span>30 秒决策速览 (GEO 核心事实摘要)</span>
        </div>
        <div class="answer-grid">
          <div class="answer-col">
            <span class="ans-label">核心线路</span>
            <span class="ans-val">{airport.lineType}</span>
          </div>
          <div class="answer-col">
            <span class="ans-label">传输协议</span>
            <span class="ans-val">{airport.protocols.join(', ')}</span>
          </div>
          <div class="answer-col">
            <span class="ans-label">最低门槛</span>
            <span class="ans-val text-gold">{airport.entryPrice}</span>
          </div>
          <div class="answer-col">
            <span class="ans-label">AI 解锁支持</span>
            <span class="ans-val text-green">
              ChatGPT: {airport.unlock.ai.chatgpt === 'yes' ? '✅ 支持' : '⚠️ 需选节点'} · Claude: {airport.unlock.ai.claude === 'yes' ? '✅ 支持' : '⚠️ 需选节点'}
            </span>
          </div>
        </div>
        <div class="answer-takeaway">
          <strong>专家简评：</strong>{airport.name} 最适合 <em>{airport.targetAudience.join('、')}</em>。
          {airport.cons.length > 0 && <span>注意事项：{airport.cons[0]}。</span>}
        </div>
      </div>
    </section>

    <!-- 悬浮 CTA 快速通道 -->
    <section class="section cta-banner-section" aria-label="Official Registration">
      <div class="cta-banner">
        <div class="cta-banner-text">
          <h3>立即前往 {airport.name} 官网</h3>
          <p>
            {airport.coupon && airport.coupon !== '待核实' && airport.coupon !== '尚未核实' ? (
              <span>专属优惠码：<code class="coupon-code">{airport.coupon}</code>（结账时输入立享折扣）</span>
            ) : (
              <span>官方正品直达通道，享受完整售后保障。</span>
            )}
          </p>
        </div>
        <div class="cta-banner-action">
          <a
            href={airport.affUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="btn-primary-large"
          >
            <span>直达官网注册</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <span class="sponsor-notice">含推广赞助链接 · 不影响结算价格</span>
        </div>
      </div>
    </section>

    <!-- 测速证据室 (Performance Observatory) -->
    {airport.speedtest && (
      <section class="section" aria-label="Speedtest Performance">
        <div class="detail-block">
          <div class="block-head">
            <h2>📊 网络测速与延迟实测数据</h2>
            <span class="block-tag">实测时间: {airport.speedtest.testedAt}</span>
          </div>

          <div class="perf-stats-row">
            <div class="perf-stat-card">
              <span class="stat-k">亚太代表节点延迟</span>
              <span class="stat-v text-green">{airport.speedtest.latency}</span>
            </div>
            <div class="perf-stat-card">
              <span class="stat-k">实测下载带宽峰值</span>
              <span class="stat-v text-accent">{airport.speedtest.peakSpeed}</span>
            </div>
            <div class="perf-stat-card">
              <span class="stat-k">测试网络环境</span>
              <span class="stat-v">千兆光纤 · Speedtest.net</span>
            </div>
          </div>

          {airport.speedtest.sampleNodes && airport.speedtest.sampleNodes.length > 0 && (
            <div class="sample-nodes-table">
              <table>
                <thead>
                  <tr>
                    <th>测试节点地区</th>
                    <th>网络往返延迟 (Ping)</th>
                    <th>下行传输速率</th>
                    <th>稳定性评估</th>
                  </tr>
                </thead>
                <tbody>
                  {airport.speedtest.sampleNodes.map((node) => (
                    <tr>
                      <td class="font-mono">🟢 {node.region}</td>
                      <td class="font-mono text-green">{node.latency}</td>
                      <td class="font-mono text-accent">{node.download}</td>
                      <td><span class="status-badge-stable">Stable 稳定</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {airport.speedtestImage && (
            <div class="evidence-image-wrap">
              <div class="image-meta-bar">
                <span>📸 原始节点测速截图归档（防伪可查验完整测试记录）：</span>
                <a href={airport.speedtestImage} target="_blank" class="view-raw-link">查看高清原图 ↗</a>
              </div>
              <div class="evidence-img-container">
                <img
                  src={airport.speedtestImage}
                  alt={`${airport.name} 节点测速实测图`}
                  loading="lazy"
                  class="evidence-img"
                />
              </div>
            </div>
          )}

          {airport.unlockImages && airport.unlockImages.length > 0 && (
            <div class="unlock-gallery-wrap">
              <h3>📸 光速云流媒体与节点实测解锁证据组图</h3>
              <div class="unlock-gallery-grid">
                {airport.unlockImages.map((imgUrl, i) => (
                  <a href={imgUrl} target="_blank" class="gallery-item">
                    <img src={imgUrl} alt={`光速云测试证据图 ${i + 1}`} loading="lazy" />
                    <span class="gallery-caption">实测截图 #{i + 1} ↗</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 服务可用性矩阵 (Service Availability Matrix) -->
    <section class="section" aria-label="Service Availability Matrix">
      <div class="detail-block">
        <div class="block-head">
          <h2>🌐 AI 平台与流媒体服务可用性矩阵</h2>
          <span class="block-tag">Service Availability Matrix</span>
        </div>

        <div class="matrix-grid">
          <div class="matrix-column">
            <h3>🤖 人工智能大模型工具 (AI Tools)</h3>
            <div class="matrix-items">
              <div class="matrix-row">
                <span class="matrix-name">OpenAI / ChatGPT</span>
                <span class={`matrix-status ${airport.unlock.ai.chatgpt === 'yes' ? 'status-yes' : 'status-partial'}`}>
                  {airport.unlock.ai.chatgpt === 'yes' ? '✅ 原生支持' : '⚠️ 需选指定节点'}
                </span>
              </div>
              <div class="matrix-row">
                <span class="matrix-name">Anthropic Claude</span>
                <span class={`matrix-status ${airport.unlock.ai.claude === 'yes' ? 'status-yes' : 'status-partial'}`}>
                  {airport.unlock.ai.claude === 'yes' ? '✅ 原生支持' : '⚠️ 需选指定节点'}
                </span>
              </div>
              <div class="matrix-row">
                <span class="matrix-name">Google Gemini</span>
                <span class={`matrix-status ${airport.unlock.ai.gemini === 'yes' ? 'status-yes' : 'status-partial'}`}>
                  {airport.unlock.ai.gemini === 'yes' ? '✅ 支持' : '⚠️ 视节点而定'}
                </span>
              </div>
            </div>
          </div>

          <div class="matrix-column">
            <h3>🎬 4K 海外流媒体平台 (Streaming Media)</h3>
            <div class="matrix-items">
              <div class="matrix-row">
                <span class="matrix-name">Netflix 网飞</span>
                <span class="matrix-status status-yes">✅ 原创剧/非自制全区解锁</span>
              </div>
              <div class="matrix-row">
                <span class="matrix-name">Disney+ 迪士尼</span>
                <span class="matrix-status status-yes">✅ 全区解锁支持</span>
              </div>
              <div class="matrix-row">
                <span class="matrix-name">YouTube Premium / 4K</span>
                <span class="matrix-status status-yes">✅ 4K/8K 码率秒开</span>
              </div>
              <div class="matrix-row">
                <span class="matrix-name">TikTok 国际版</span>
                <span class="matrix-status status-yes">✅ 跨境直播与养号支持</span>
              </div>
              <div class="matrix-row">
                <span class="matrix-name">Spotify 声飞</span>
                <span class="matrix-status status-yes">✅ 全球曲库正常播放</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 网络拓扑与架构说明 (Network Path Observatory) -->
    <section class="section" aria-label="Network Architecture">
      <div class="detail-block">
        <div class="block-head">
          <h2>🗺️ 专线网络拓扑与抗干扰机制</h2>
          <span class="block-tag">Network Path Observatory</span>
        </div>

        <div class="topology-box font-mono">
          <div class="topo-step">
            <span class="topo-icon">💻</span>
            <span class="topo-title">[用户本地设备]</span>
            <span class="topo-desc">手机 / 电脑 / 软路由</span>
          </div>
          <div class="topo-arrow">│ 加密握手 ({airport.protocols.join('/')}) ▼</div>
          <div class="topo-step">
            <span class="topo-icon">🛡️</span>
            <span class="topo-title">[国内优质入口集群]</span>
            <span class="topo-desc">BGP 多线智能调度入口 · 屏蔽真实 IP</span>
          </div>
          <div class="topo-arrow highlight-arrow">════ 内网专线直连 (跨境不经公网 GFW) ════▶</div>
          <div class="topo-step">
            <span class="topo-icon">🌐</span>
            <span class="topo-title">[海外原生落地机房]</span>
            <span class="topo-desc">{airport.nodesSummary}</span>
          </div>
          <div class="topo-arrow">│ 原生 IP 分流 ▼</div>
          <div class="topo-step">
            <span class="topo-icon">🎯</span>
            <span class="topo-title">[目标业务访问]</span>
            <span class="topo-desc">Google / GitHub / ChatGPT / Netflix 4K 秒开</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 套餐价格详细清单 -->
    <section class="section" aria-label="Pricing Plans">
      <div class="detail-block">
        <div class="block-head">
          <h2>💰 套餐规格与价格清单</h2>
          <span class="block-tag">全套餐对比</span>
        </div>

        <div class="plans-table-wrap">
          <table class="plans-table">
            <thead>
              <tr>
                <th>套餐档位</th>
                <th>付费周期</th>
                <th>价格</th>
                <th>流量配额</th>
                <th>定位与说明</th>
              </tr>
            </thead>
            <tbody>
              {airport.pricingTiers.map((tier) => (
                <tr>
                  <td class="font-mono font-bold">{tier.name}</td>
                  <td><span class="period-pill">{tier.period}</span></td>
                  <td class="font-mono text-gold font-bold">{tier.price}</td>
                  <td class="font-mono">{tier.traffic}</td>
                  <td class="text-soft">{tier.desc || '标准高速专线网络'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 优缺点与适合人群对比 -->
    <section class="section" aria-label="Pros and Cons">
      <div class="pros-cons-grid">
        <div class="pros-box">
          <h3>✅ 优势亮点 (Pros)</h3>
          <ul>
            {airport.pros.map((pro) => (
              <li>{pro}</li>
            ))}
          </ul>
        </div>
        <div class="cons-box">
          <h3>⚠️ 限制与选型建议 (Cons)</h3>
          <ul>
            {airport.cons.map((con) => (
              <li>{con}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 客户端下载与使用指引 -->
    <section class="section" aria-label="Client Setup">
      <div class="detail-block">
        <div class="block-head">
          <h2>📱 适用客户端与导入方法</h2>
          <a href="/clients/" class="block-link">浏览全平台客户端详细教程 →</a>
        </div>
        <p class="section-p">
          {airport.name} {airport.clients.hasSelfDevApp ? '提供开箱即用的专属自研客户端，用户登录后无需配置节点即可一键连接。' : '支持主流通用代理客户端协议。'}
          您可以在 Windows、Android、iOS、macOS 及软路由设备上配合以下第三方客户端使用：
        </p>
        <div class="client-chips-list">
          {airport.clients.thirdParty.length > 0 ? (
            airport.clients.thirdParty.map((client) => (
              <span class="client-chip">{client}</span>
            ))
          ) : (
            <span class="client-chip">官方专属自研客户端</span>
          )}
        </div>
      </div>
    </section>

    <!-- 底部直达浮动卡片 -->
    <section class="section" aria-label="Final Conversion Action">
      <div class="bottom-conversion-card">
        <div class="bottom-conv-content">
          <h3>准备开始使用 {airport.name}？</h3>
          <p>
            点击下方按钮前往官方主页。如遇疑问，建议先选择月付或轻量版套餐进行小额实测体验。
          </p>
        </div>
        <a
          href={airport.affUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="btn-primary-large"
        >
          <span>立即前往官方注册</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  /* Breadcrumbs */
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .breadcrumb-nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--accent);
  }

  .breadcrumb-nav .sep {
    color: var(--line-strong);
  }

  .breadcrumb-nav .curr {
    color: var(--ink);
    font-weight: 600;
  }

  /* Detail Header */
  .airport-detail-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2rem;
  }

  .header-tags-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .rank-tag {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .badge-pill {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius-sm);
  }

  .meta-pill {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    padding: 0.18rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .airport-main-title {
    font-family: var(--mono);
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    font-weight: 800;
    margin: 0 0 1rem;
    color: var(--ink);
    letter-spacing: -0.04em;
  }

  .airport-sub-lede {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 820px;
    margin: 0;
  }

  /* Direct Answer Box (GEO) */
  .direct-answer-box {
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-elevated) 92%, var(--accent-soft));
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
  }

  .answer-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);

---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { slugifyTag, skills } from '../../lib/tags';
import { SITE_NAME } from '../../lib/site';

export async function getStaticPaths() {
  const [blogPosts, freePosts, toolsPosts, faqPosts, runawayPosts] = await Promise.all([
    getCollection('blog'),
    getCollection('free'),
    getCollection('tools'),
    getCollection('faq'),
    getCollection('runaway'),
  ]);

  interface PostItem {
    title: string;
    description: string;
    date: Date;
    tags: string[];
    url: string;
    topicName: string;
  }

  const allItems: PostItem[] = [
    ...blogPosts.filter(p => !p.data.draft).map(p => ({
      title: p.data.title,
      description: p.data.description,
      date: p.data.date,
      tags: p.data.tags,
      url: `/blog/${p.id}/`,
      topicName: '专题评测',
    })),
    ...freePosts.filter(p => !p.data.draft).map(p => ({
      title: p.data.title,
      description: p.data.description,
      date: p.data.date,
      tags: p.data.tags,
      url: `/free/${p.id}/`,
      topicName: '免费资源',
    })),
    ...toolsPosts.filter(p => !p.data.draft).map(p => ({
      title: p.data.title,
      description: p.data.description,
      date: p.data.date,
      tags: p.data.tags,
      url: `/tools/${p.id}/`,
      topicName: '梯子工具',
    })),
    ...faqPosts.filter(p => !p.data.draft).map(p => ({
      title: p.data.title,
      description: p.data.description,
      date: p.data.date,
      tags: p.data.tags,
      url: `/faq/${p.id}/`,
      topicName: '机场FAQ',
    })),
    ...runawayPosts.filter(p => !p.data.draft).map(p => ({
      title: p.data.title,
      description: p.data.description,
      date: p.data.date,
      tags: p.data.tags,
      url: `/runaway/${p.id}/`,
      topicName: '跑路预警',
    })),
  ];

  // Group by slug
  const tagMap = new Map<string, { name: string; posts: PostItem[] }>();

  // Ensure default skills are present
  for (const s of skills) {
    const slug = slugifyTag(s);
    if (slug && !tagMap.has(slug)) {
      tagMap.set(slug, { name: s, posts: [] });
    }
  }

  // Populate posts
  for (const item of allItems) {
    for (const t of item.tags) {
      const slug = slugifyTag(t);
      if (!slug) continue;
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { name: t, posts: [] });
      }
      tagMap.get(slug)!.posts.push(item);
    }
  }

  return [...tagMap.entries()].map(([slug, { name, posts }]) => ({
    params: { tag: slug },
    props: {
      name,
      slug,
      posts: posts.sort((a, b) => b.date.valueOf() - a.date.valueOf()),
    },
  }));
}

interface Props {
  name: string;
  slug: string;
  posts: Array<{
    title: string;
    description: string;
    date: Date;
    tags: string[];
    url: string;
    topicName: string;
  }>;
}

const { name, slug, posts } = Astro.props;
---

<Layout
  title={`#${name} — ${SITE_NAME}`}
  description={`${SITE_NAME} 标签 #${name} 下的相关文章列表与技术指南。`}
  canonicalPath={`/tags/${slug}/`}
>
  <main class="content-shell">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/">首页</a>
      <span class="separator">/</span>
      <a href="/tags/">全部标签</a>
      <span class="separator">/</span>
      <span class="current">#{name}</span>
    </nav>

    <section class="page-hero">
      <p class="eyebrow"><span class="status-dot dot-blue"></span>TAG ARCHIVE</p>
      <h1># {name}</h1>
      <p class="hero-lede">
        {posts.length === 0
          ? `该标签下暂无收录文章，我们正持续扩充该方向实测。`
          : `共找到 ${posts.length} 篇与 “${name}” 相关的专业评测、技术指南与选型报告。`}{' '}
        <a class="inline-link" href="/tags/">浏览全部标签索引 →</a>
      </p>
    </section>

    {posts.length > 0 && (
      <section class="section" aria-label="Posts">
        <div class="tag-posts-list">
          {posts.map((post) => (
            <article class="tag-post-item">
              <div class="post-item-meta">
                <span class="post-topic-tag">{post.topicName}</span>
                <span class="post-date">{post.date.toISOString().slice(0, 10)}</span>
              </div>
              <h2 class="post-item-title">
                <a href={post.url}>{post.title}</a>
              </h2>
              <p class="post-item-desc">{post.description}</p>
              <div class="post-item-tags">
                {post.tags.map(t => (
                  <a href={`/tags/${slugifyTag(t)}/`} class="sub-tag">#{t}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .tag-posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .tag-post-item {
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    transition: transform 0.2s, border-color 0.2s;
  }
  .tag-post-item:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .post-item-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }
  .post-topic-tag {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
  }
  .post-date {
    color: var(--muted);
  }
  .post-item-title {
    font-family: var(--sans), sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
    line-height: 1.4;
  }
  .post-item-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .post-item-title a:hover {
    color: var(--accent);
  }
  .post-item-desc {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .post-item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .sub-tag {
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
  }
  .sub-tag:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .inline-link {
    color: var(--accent);
    font-family: var(--mono);
    font-weight: 600;
  }
  .inline-link:hover {
    text-decoration: underline;
  }
</style>
